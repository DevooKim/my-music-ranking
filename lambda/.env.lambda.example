# Spotify API Credentials
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token

# AWS Configuration
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=my-music-ranking
S3_ARTIFACTS_BUCKET=my-music-ranking-artifacts-1766068945

# Optional: configure only after the Funnel endpoint is deployed.
REVALIDATE_ENDPOINT_URL=https://your-tailnet-hostname.ts.net/api/revalidate
REVALIDATE_SECRET=replace-with-the-same-long-random-secret
