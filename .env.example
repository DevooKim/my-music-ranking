# 기본 환경
S3_BUCKET=your-bucket
S3_REGION=ap-northeast-2
CHART_TIME_ZONE=Asia/Seoul
TRACK_STATS_READ_PREFERENCE=parquet

# AWS 자격증명 (로컬 실행 시)
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_SESSION_TOKEN=your-session-token

# Spotify API
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REFRESH_TOKEN=your-spotify-refresh-token

# Cache 정책
SPOTIFY_RAW_COLLECTION_INTERVAL_SECONDS=7200
CHART_LATEST_CACHE_MAX_AGE_SECONDS=3600
CHART_LATEST_CACHE_SWR_SECONDS=3600
CHART_LATEST_NOT_FOUND_CACHE_MAX_AGE_SECONDS=600
CHART_LATEST_NOT_FOUND_CACHE_SWR_SECONDS=120
CHART_FOUND_CACHE_MAX_AGE_SECONDS=2592000
CHART_FOUND_CACHE_SWR_SECONDS=2592000
CHART_NOT_FOUND_CACHE_MAX_AGE_SECONDS=120
CHART_NOT_FOUND_CACHE_SWR_SECONDS=600

# Artist thumbnail cache
ARTIST_THUMBNAIL_TTL_DAYS=14
ARTIST_THUMBNAIL_AUTO_REFRESH=true
ARTIST_THUMBNAIL_S3_CACHE_TTL_SECONDS=1209600
ARTIST_THUMBNAIL_USE_LOCAL_FS=false
ARTIST_THUMBNAIL_LOCAL_CACHE_DIR=.cache/artist-thumbnails
